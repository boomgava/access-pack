{
  "name": "access-pack",
  "productName": "AccessPack",
  "version": "1.4.0",
  "description": "Пакет доступов: ZIP на каждого сотрудника с PDF-памяткой, паролем и вложениями",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "ACCESS_PACK_DEMO=edit electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "smoke:pdf": "electron scripts/smoke-pdf.js",
    "smoke:build": "electron scripts/smoke-build.js",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boomgava/access-pack.git"
  },
  "homepage": "https://github.com/boomgava/access-pack",
  "license": "MIT"
}
